{
  "compilerOptions": {
    "jsx": "preserve",
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "Node",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "allowJs": true,
    "typeRoots": [

      "./node_modules/vue/types",

      "./types/packages"

    ],
    "paths": {
      "@/*": ["./examples/*"],
      "#/*": ["./packages/*"],
      "@@/*": ["./*"],
      "~/*": ["./node_modules/*"]
    },
    "skipLibCheck": true
  },
  "include": ["examples", "packages"]
}
